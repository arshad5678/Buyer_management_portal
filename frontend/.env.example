# Frontend environment variables
#
# Development:
#   VITE_API_URL=/api
#   The Vite dev server proxies /api → http://localhost:5001 (see vite.config.js)
#
# Production (Vercel):
#   Set VITE_API_URL to your deployed Render backend URL + /api
#   Example: VITE_API_URL=https://buyer-management-portal-backend.onrender.com/api
#   Set this in the Vercel dashboard under Project → Settings → Environment Variables
VITE_API_URL=/api
